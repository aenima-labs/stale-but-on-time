#!/bin/bash
# Experiment 2 job on a GPU machine (rendered by Terraform; see main.tf).
# Runs once. Whatever happens, the EXIT trap uploads what exists and deletes
# this machine. Compute Engine's max_run_duration deletes it regardless.
set -euo pipefail

BUCKET="${bucket}"
SOURCE="${source_object}"
RUN="${run_name}"
INSTANCE="${instance}"
ZONE="${zone}"
MODELS="${models}"
RUN_ARGS="${run_args}"
OLLAMA_VERSION="${ollama_version}"
UV_VERSION="${uv_version}"

WORK=/opt/sbot
LOG=/var/log/sbot-e2-job.log
STATUS="gs://$BUCKET/status"
exec > >(tee -a "$LOG") 2>&1

stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
mark() { echo "$(stamp) $2" | gcloud storage cp - "$STATUS/$1" --quiet || true; }

finish() {
  rc=$?
  set +e
  if [ -d "$WORK/results/$RUN" ]; then
    gcloud storage cp -r "$WORK/results/$RUN" "gs://$BUCKET/results/" --quiet
  fi
  gcloud storage cp "$LOG" "gs://$BUCKET/log/job.log" --quiet
  if [ "$rc" -eq 0 ]; then mark DONE "exit 0"; else mark FAILED "exit $rc"; fi
  mark DELETING "self-delete"
  gcloud compute instances delete "$INSTANCE" --zone "$ZONE" --quiet
}

# A reboot must not start a second run: the machine just cleans up and goes.
if [ -f /var/lib/sbot-started ]; then
  echo "rebooted after the job started; deleting"
  trap finish EXIT
  exit 3
fi
touch /var/lib/sbot-started
trap finish EXIT
mark BOOTED "$(hostname)"

nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

# Ollama, pinned to the release of the stored runs, with the laptop's settings.
cd /tmp
curl -fsSL -o ollama.tgz "https://github.com/ollama/ollama/releases/download/v$OLLAMA_VERSION/ollama-linux-amd64.tgz"
tar -C /usr/local -xzf ollama.tgz
OLLAMA_HOST=127.0.0.1:11434 OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 \
  OLLAMA_KEEP_ALIVE=24h nohup /usr/local/bin/ollama serve > /var/log/ollama.log 2>&1 &
for _ in $(seq 60); do curl -fs http://127.0.0.1:11434/api/version && break; sleep 2; done
for m in $MODELS; do /usr/local/bin/ollama pull "$m"; done
mark MODELS_READY "$MODELS"

# uv, pinned.
curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh

# The repository at the commit the task archived.
mkdir -p "$WORK"
gcloud storage cp "gs://$BUCKET/$SOURCE" /tmp/source.tgz --quiet
tar -C "$WORK" -xzf /tmp/source.tgz
cd "$WORK"
uv sync --frozen

# What the machine was (no names, no addresses).
mkdir -p "results/$RUN/machine"
nvidia-smi -q > "results/$RUN/machine/nvidia-smi.txt"
lscpu > "results/$RUN/machine/lscpu.txt"
free -g > "results/$RUN/machine/memory.txt"
curl -fs http://127.0.0.1:11434/api/version > "results/$RUN/machine/ollama-version.json"
curl -fs -H Metadata-Flavor:Google \
  "http://metadata.google.internal/computeMetadata/v1/instance/machine-type" \
  | sed 's#.*/##' > "results/$RUN/machine/machine-type.txt"

mark RUN_STARTED "$RUN_ARGS"
# Local models only: the estimate and confirmation were done by the task.
OLLAMA_URL=http://127.0.0.1:11434 uv run inv e2.run --args="--yes --out results/$RUN $RUN_ARGS"
curl -fs http://127.0.0.1:11434/api/ps > "results/$RUN/machine/ollama-ps.json"
mark RUN_FINISHED "ok"
